#!/bin/bash
# pib-chrome - lifecycle of the agent's own Chrome.
#
# A second Chrome, separate from mino's daily browser, with its own profile,
# exposing CDP on loopback. Normally invisible: it runs inside a headless
# `cage` compositor, so its windows cannot appear on screen or take focus,
# while still being ordinary headful Chrome (real UA, real GPU).
#
# What this does differently from the old pi-chrome, and why:
#   - Only ever signals processes it started (pidfile + private process name).
#     pi-chrome used `pgrep -x cage`, which also hits any other cage.
#   - Gives the headless compositor a pointer device. Without one Chrome
#     reports (any-pointer: none) / (hover: none): a bot tell, and sites then
#     serve their touch layout.
#   - 1920x1080 output instead of wlroots' 1280x720 default.
#   - `update` installs a current Chrome into a private directory, verified
#     against Google's signed apt metadata. /opt/google/chrome only changes
#     when someone remembers to do it by hand, and was 6 major versions behind.
#
# Flags are deliberately minimal. Never add --enable-automation, --headless,
# --no-sandbox or --disable-blink-features: they are what make a browser look
# automated.

set -uo pipefail

PORT="${PIB_PORT:-9222}"
STATE="${PIB_HOME:-$HOME/.local/share/pib}"
PROFILE="${PIB_PROFILE:-$HOME/.local/share/pi-browser/chrome-profile}"
SIZE="${PIB_SIZE:-1920x1080}"
LOG="$STATE/chrome.log"
MODE_FILE="$STATE/mode"
CAGE_PID="$STATE/cage.pid"
CHROME_PID="$STATE/chrome.pid"
POINTER_PID="$STATE/pointer.pid"
CHROME_DIR="$STATE/chrome"
HERE="$(dirname "$(readlink -f "$0")")"
POINTER="$HERE/../libexec/virtual-pointer.py"

chrome_bin() {
  if [ -n "${PIB_CHROME_BIN:-}" ]; then echo "$PIB_CHROME_BIN"
  elif [ -x "$CHROME_DIR/current/chrome" ]; then echo "$CHROME_DIR/current/chrome"
  else echo /opt/google/chrome/chrome
  fi
}

usage() {
  cat <<'EOF'
usage: pib-chrome <command>

  start [--visible]   launch (default: invisible, cannot take focus)
  stop                shut down the browser this script started
  restart             stop, then start invisible
  status              mode, version, update state, open tabs
  login <url>         restart VISIBLE and open <url> for a manual sign-in
  background          back to invisible (run after signing in)
  update [--check]    install the current stable Chrome privately (verified)
  profile             print the profile path

env: PIB_PORT PIB_PROFILE PIB_HOME PIB_SIZE PIB_CHROME_BIN
EOF
}

alive() { curl -sf --max-time 2 "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1; }
mode() { cat "$MODE_FILE" 2>/dev/null || echo unknown; }
# A pidfile is only believed if that pid is still the process it was written
# for. Pids get reused (after a crash, after a reboot), and stop sends signals.
pid_of() {
  local p want
  p="$(cat "$1" 2>/dev/null)" && [ -n "$p" ] && kill -0 "$p" 2>/dev/null || return 1
  case "$1" in
    "$CHROME_PID")  want="--user-data-dir=$PROFILE" ;;
    "$CAGE_PID")    want="pib-cage" ;;
    "$POINTER_PID") want="virtual-pointer.py" ;;
  esac
  tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | grep -qF -- "$want" && echo "$p"
}
# True only if the process on the port is the one we started.
ours() { local p; p="$(pid_of "$CHROME_PID")" && [ -n "$p" ]; }
port_owner() { ss -ltnpH "sport = :$PORT" 2>/dev/null | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | head -1; }

chrome_args() {
  printf '%s\n' \
    "--user-data-dir=$PROFILE" \
    "--remote-debugging-port=$PORT" \
    "--remote-debugging-address=127.0.0.1" \
    "--no-first-run" \
    "--no-default-browser-check" \
    "--ozone-platform=wayland"
}

wait_up() {
  for _ in $(seq 1 60); do
    sleep 0.25
    alive && return 0
  done
  return 1
}

# The browser process that owns the debugging port is the one to remember:
# under cage it is cage's child, in visible mode it is what we launched.
record_chrome_pid() {
  local p
  p="$(port_owner)"
  [ -n "$p" ] && echo "$p" >"$CHROME_PID"
}

setup_headless_seat() {
  local chrome display
  chrome="$(pid_of "$CHROME_PID")" || return 0
  display="$(tr '\0' '\n' <"/proc/$chrome/environ" 2>/dev/null | sed -n 's/^WAYLAND_DISPLAY=//p')"
  [ -n "$display" ] || { echo "pib-chrome: could not find the compositor socket; no pointer device, default size" >&2; return 0; }
  if command -v wlr-randr >/dev/null; then
    WAYLAND_DISPLAY="$display" wlr-randr --output HEADLESS-1 --custom-mode "$SIZE" >>"$LOG" 2>&1 \
      || echo "pib-chrome: could not set $SIZE, staying at the compositor default" >&2
  fi
  if [ -f "$POINTER" ]; then
    setsid nohup python3 "$POINTER" "$display" >>"$LOG" 2>&1 </dev/null &
    echo $! >"$POINTER_PID"
    disown
  fi
}

do_start() {
  local visible=0 chrome
  [ "${1:-}" = "--visible" ] && visible=1
  chrome="$(chrome_bin)"

  if alive; then
    if ours; then echo "pib-chrome: already running ($(mode) mode) on 127.0.0.1:$PORT"
    else echo "pib-chrome: port $PORT is already served by another browser (pid $(port_owner), not started by pib-chrome); leaving it alone"
    fi
    return 0
  fi
  [ -x "$chrome" ] || { echo "pib-chrome: no Chrome at $chrome (try: pib-chrome update)" >&2; return 1; }
  mkdir -p "$PROFILE" "$STATE"

  mapfile -t args < <(chrome_args)
  if [ "$visible" = 1 ]; then
    setsid nohup "$chrome" "${args[@]}" >>"$LOG" 2>&1 </dev/null &
    disown
    echo visible >"$MODE_FILE"
  else
    command -v cage >/dev/null || { echo "pib-chrome: cage is not installed; use --visible, or install cage" >&2; return 1; }
    # A private name for the compositor process, so nothing that goes looking
    # for "cage" (e.g. the old pi-chrome) can mistake it for its own.
    ln -sfn "$(command -v cage)" "$STATE/pib-cage"
    # No WAYLAND_DISPLAY/DISPLAY: wlroots must pick the headless backend, not
    # nest a visible window inside the desktop session.
    env -u WAYLAND_DISPLAY -u DISPLAY \
      WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 WLR_HEADLESS_OUTPUTS=1 \
      setsid nohup "$STATE/pib-cage" -- "$chrome" "${args[@]}" --no-startup-window \
      >>"$LOG" 2>&1 </dev/null &
    echo $! >"$CAGE_PID"
    disown
    echo background >"$MODE_FILE"
  fi

  if ! wait_up; then
    echo "pib-chrome: did not come up within 15s; see $LOG" >&2
    return 1
  fi
  record_chrome_pid
  [ "$visible" = 1 ] || setup_headless_seat
  echo "pib-chrome: up on 127.0.0.1:$PORT ($(mode) mode, $("$chrome" --version 2>/dev/null | sed 's/ *$//'))"
}

do_stop() {
  local chrome cage pointer
  chrome="$(pid_of "$CHROME_PID")"
  cage="$(pid_of "$CAGE_PID")"
  pointer="$(pid_of "$POINTER_PID")"
  if [ -z "$chrome" ] && [ -z "$cage" ]; then
    if alive; then
      echo "pib-chrome: the browser on port $PORT was not started by pib-chrome (pid $(port_owner)); not touching it" >&2
      return 1
    fi
    echo "pib-chrome: not running"
    rm -f "$MODE_FILE" "$CHROME_PID" "$CAGE_PID" "$POINTER_PID"
    return 0
  fi
  [ -n "$chrome" ] && kill "$chrome" 2>/dev/null
  for _ in $(seq 1 40); do
    sleep 0.25
    [ -z "$(pid_of "$CHROME_PID")" ] && break
  done
  chrome="$(pid_of "$CHROME_PID")"
  [ -n "$chrome" ] && kill -9 "$chrome" 2>/dev/null
  # cage exits with its only client; reap it if it did not.
  sleep 0.3
  cage="$(pid_of "$CAGE_PID")"
  [ -n "$cage" ] && kill "$cage" 2>/dev/null
  [ -n "$pointer" ] && kill "$pointer" 2>/dev/null
  rm -f "$MODE_FILE" "$CHROME_PID" "$CAGE_PID" "$POINTER_PID"
  echo "pib-chrome: stopped"
}

latest_version() {
  curl -fsS --max-time 8 "https://versionhistory.googleapis.com/v1/chrome/platforms/linux/channels/stable/versions?pageSize=1" 2>/dev/null \
    | sed -n 's/.*"version": *"\([0-9.]*\)".*/\1/p' | head -1
}

do_status() {
  if ! alive; then
    echo "pib-chrome: DOWN (port $PORT)"
    return 1
  fi
  local running latest
  running="$(curl -s --max-time 3 "http://127.0.0.1:$PORT/json/version" | sed -n 's/.*"Browser": "[^/]*\/\([^"]*\)".*/\1/p')"
  if ours; then echo "pib-chrome: UP on 127.0.0.1:$PORT  [$(mode) mode]"
  else echo "pib-chrome: a browser is UP on 127.0.0.1:$PORT, but it was not started by pib-chrome (pid $(port_owner))"
  fi
  echo "  chrome:  $running"
  latest="$(latest_version)"
  if [ -n "$latest" ] && [ "${running%%.*}" != "${latest%%.*}" ]; then
    echo "  WARNING: current stable is $latest ($(( ${latest%%.*} - ${running%%.*} )) major versions newer). Run: pib-chrome update && pib-chrome restart"
  elif [ -n "$latest" ] && [ "$running" != "$latest" ]; then
    echo "  update:  $latest is available (pib-chrome update)"
  fi
  echo "  profile: $PROFILE"
  echo "  tabs:"
  curl -s --max-time 3 "http://127.0.0.1:$PORT/json/list" | python3 -c '
import sys, json
try:
    pages = [t for t in json.load(sys.stdin) if t["type"] == "page"]
except Exception:
    pages = []
if not pages:
    print("    (none)")
for t in pages:
    print("    %-8s %-40s %s" % (t["id"][:8], (t.get("title") or "")[:40], t["url"][:60]))
'
}

do_login() {
  local url="${1:-}"
  [ -n "$url" ] || { echo "usage: pib-chrome login <url>" >&2; return 1; }
  if alive && ! ours; then
    echo "pib-chrome: the browser on port $PORT is not pib-chrome's; not restarting it" >&2
    return 1
  fi
  if alive && [ "$(mode)" != visible ]; then
    local tabs
    tabs="$(curl -s --max-time 3 "http://127.0.0.1:$PORT/json/list" | grep -c '"type": "page"')"
    echo "pib-chrome: restarting visible for a manual sign-in (this closes $tabs open agent tab(s))..."
    do_stop
    sleep 1
  fi
  alive || do_start --visible || return 1
  setsid nohup "$(chrome_bin)" "--user-data-dir=$PROFILE" "$url" >>"$LOG" 2>&1 </dev/null &
  disown
  echo "pib-chrome: opened $url - sign in there, then run: pib-chrome background"
}

do_background() {
  if alive && ours && [ "$(mode)" = background ]; then
    echo "pib-chrome: already in background mode"
    return 0
  fi
  if alive; then do_stop || return 1; sleep 1; fi
  do_start
}

# Install the current stable Chrome under $CHROME_DIR/<version>, checked
# against Google's apt repository: Release is signed by Google's packaging key,
# Release pins the hash of Packages, Packages pins the hash of the .deb.
GOOGLE_KEY_FPR="EB4C1BFD4F042F6DDDCCEC917721F63BD38B4796"
do_update() {
  local check=0 repo=https://dl.google.com/linux/chrome/deb tmp ver file sha have
  [ "${1:-}" = "--check" ] && check=1
  for tool in curl gpg ar tar sha256sum; do
    command -v "$tool" >/dev/null || { echo "pib-chrome: update needs $tool" >&2; return 1; }
  done
  tmp="$(mktemp -d)" || return 1
  trap 'rm -rf "$tmp"' RETURN
  curl -fsS --max-time 30 "$repo/dists/stable/Release" -o "$tmp/Release" \
    && curl -fsS --max-time 30 "$repo/dists/stable/Release.gpg" -o "$tmp/Release.gpg" \
    && curl -fsS --max-time 30 "$repo/dists/stable/main/binary-amd64/Packages" -o "$tmp/Packages" \
    && curl -fsS --max-time 30 https://dl.google.com/linux/linux_signing_key.pub -o "$tmp/key.pub" \
    || { echo "pib-chrome: could not fetch the repository metadata" >&2; return 1; }

  # Verify in a throwaway GnuPG home. (Not --keyring: with `use-keyboxd` in
  # ~/.gnupg/common.conf gpg ignores it and imports into the user's own keys.)
  # VALIDSIG's last field is the primary key fingerprint, so one match proves
  # both "the signature is good" and "it was made by Google's packaging key".
  mkdir -m 700 "$tmp/gnupg"
  gpg --homedir "$tmp/gnupg" --batch --quiet --import "$tmp/key.pub" >/dev/null 2>&1
  gpg --homedir "$tmp/gnupg" --batch --status-fd 1 --verify "$tmp/Release.gpg" "$tmp/Release" 2>/dev/null \
    | grep -q "^\[GNUPG:\] VALIDSIG .* $GOOGLE_KEY_FPR\$" \
    || { echo "pib-chrome: the repository signature does not verify against Google's key ($GOOGLE_KEY_FPR); refusing" >&2; return 1; }
  gpgconf --homedir "$tmp/gnupg" --kill all >/dev/null 2>&1
  sha="$(sha256sum "$tmp/Packages" | cut -d' ' -f1)"
  grep -q "^ $sha .* main/binary-amd64/Packages$" "$tmp/Release" \
    || { echo "pib-chrome: the package index does not match the signed release file; refusing" >&2; return 1; }

  ver="$(awk -v RS= '/Package: google-chrome-stable\n/' "$tmp/Packages" | sed -n 's/^Version: \([0-9.]*\).*/\1/p' | head -1)"
  file="$(awk -v RS= '/Package: google-chrome-stable\n/' "$tmp/Packages" | sed -n 's/^Filename: //p' | head -1)"
  sha="$(awk -v RS= '/Package: google-chrome-stable\n/' "$tmp/Packages" | sed -n 's/^SHA256: //p' | head -1)"
  [ -n "$ver" ] && [ -n "$file" ] && [ -n "$sha" ] || { echo "pib-chrome: could not read the package index" >&2; return 1; }
  have="$(readlink "$CHROME_DIR/current" 2>/dev/null)"
  if [ "$have" = "$ver" ] && [ -x "$CHROME_DIR/$ver/chrome" ]; then
    echo "pib-chrome: private Chrome is current ($ver)"
    return 0
  fi
  if [ "$check" = 1 ]; then
    echo "pib-chrome: Chrome $ver is available (installed privately: ${have:-none}; running binary: $(chrome_bin))"
    return 0
  fi

  echo "pib-chrome: downloading Chrome $ver ..."
  local progress=-s
  [ -t 2 ] && progress=--progress-bar
  curl -fS "$progress" --max-time 900 "$repo/$file" -o "$tmp/chrome.deb" || { echo "pib-chrome: download failed" >&2; return 1; }
  echo "$sha  $tmp/chrome.deb" | sha256sum -c --quiet - \
    || { echo "pib-chrome: the download does not match its signed hash; refusing" >&2; return 1; }
  (cd "$tmp" && ar x chrome.deb && tar -xf data.tar.* ./opt/google/chrome) \
    || { echo "pib-chrome: could not unpack the package" >&2; return 1; }
  # Not setuid when unpacked by a user, and a non-setuid helper makes Chrome
  # abort. Without it Chrome uses the user-namespace sandbox, which is as good.
  rm -f "$tmp/opt/google/chrome/chrome-sandbox"
  mkdir -p "$CHROME_DIR"
  rm -rf "$CHROME_DIR/$ver"
  mv "$tmp/opt/google/chrome" "$CHROME_DIR/$ver" || return 1
  ln -sfn "$ver" "$CHROME_DIR/current"
  # Keep the new one and the one before it.
  ls -1 "$CHROME_DIR" | grep -E '^[0-9.]+$' | grep -vx -e "$ver" -e "$have" | while read -r old; do rm -rf "${CHROME_DIR:?}/$old"; done
  echo "pib-chrome: installed Chrome $ver in $CHROME_DIR/$ver"
  alive && ours && echo "pib-chrome: the running browser is still the old one; pib-chrome restart to switch"
  return 0
}

case "${1:-}" in
  start)      shift; do_start "$@" ;;
  stop)       do_stop ;;
  restart)    do_stop && sleep 1 && do_start ;;
  status)     do_status ;;
  login)      shift; do_login "$@" ;;
  background) do_background ;;
  update)     shift; do_update "$@" ;;
  profile)    echo "$PROFILE" ;;
  ""|-h|--help|help) usage ;;
  *) echo "pib-chrome: unknown command '$1'" >&2; usage; exit 1 ;;
esac
